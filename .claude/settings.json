{
  "agent": "chief-of-staff",
  "enabledPlugins": {
    "claude-code-sdlc@claude-code-sdlc": false
  },
  "permissions": {
    "allow": [],
    "deny": []
  },
  "autoCompactWindow": 250000,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node shared/scripts/scheduler-rearm-notice.mjs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node shared/scripts/context-budget-notice.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node shared/scripts/human-prompt-gate.mjs"
          }
        ]
      }
    ]
  }
}
